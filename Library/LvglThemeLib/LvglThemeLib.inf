[Defines]
  INF_VERSION     = 0x0001001B
  BASE_NAME       = LvglThemeLib
  FILE_GUID       = 7a3c9e2f-4b1d-4f8a-9c6e-2d5b8a1f0e34
  MODULE_TYPE     = DXE_DRIVER
  VERSION_STRING  = 1.0
  LIBRARY_CLASS   = LvglThemeLib|DXE_DRIVER UEFI_APPLICATION

[Sources]
  LvglThemeLib.c

[Packages]
  MdePkg/MdePkg.dec
  LvglPkg/LvglPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DxeServicesLib
  MemoryAllocationLib
  PcdLib

[Pcd]
  gLvglPkgTokenSpaceGuid.PcdLvglTtfFontFile    ## CONSUMES

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -I$(WORKSPACE)/LvglPkg/Library/LvglLib
  MSFT:*_*_*_CC_FLAGS = /I$(WORKSPACE)/LvglPkg/Library/LvglLib /wd4244 /wd4204 /wd4389 /wd4221 /wd4800 /wd4267 /wd4018 /wd4047 /wd4245 /wd4003 /wd4702 /wd4718 /wd4706 /wd4819 /wd4028 /wd5287
