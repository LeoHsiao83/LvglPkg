
[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = LvglPkg
  PACKAGE_GUID                   = 5719B5C8-5F9A-4205-BD09-2E416EF4BDCC
  PACKAGE_VERSION                = 0.98

[Includes]
  Include
  Library/LvglLib/lvgl

[Includes.Common.Private]


[LibraryClasses]
  LvglLib|Include/Library/LvglLib.h
  LvglThemeLib|Include/Library/LvglThemeLib.h
  LvglChromeLib|Include/Library/LvglChromeLib.h
  LvglEzChromeLib|Include/Library/LvglEzChromeLib.h

[Guids]
  ## LVGL UI configuration formset / variable GUID
  gLvglUiConfigFormSetGuid = { 0xddb969f2, 0xe99b, 0x4dd5, { 0x8e, 0x36, 0xb8, 0x0b, 0x52, 0x6d, 0x3b, 0x73 } }

  ## Token space for LvglPkg platform overrides (chrome strings, layout).
  gLvglPkgTokenSpaceGuid = { 0xd27adb1f, 0x1e75, 0x4e16, { 0xbf, 0x45, 0xf0, 0xf4, 0x0f, 0xfa, 0xef, 0xe8 } }

[PcdsFixedAtBuild, PcdsPatchableInModule]
  ## Help pane width as a percentage of the content row (Middle band).
  #  ~19 matches the default 240 px fixed width on a 1280 px panel.
  gLvglPkgTokenSpaceGuid.PcdLvglHelpPaneWidthPct|19|UINT8|0x00000001

  ## Header bar title (left).
  gLvglPkgTokenSpaceGuid.PcdLvglAptioHeaderTitle|"EDK II Boot Manager"|VOID*|0x00000002

  ## Header bar vendor/version string (center). Empty string is allowed.
  gLvglPkgTokenSpaceGuid.PcdLvglAptioHeaderVendor|"UEFI v2.90  |  EDK II"|VOID*|0x00000003

  ## When TRUE, cap the UI to a centered window with a fixed aspect ratio
  ## instead of filling the display edge-to-edge (useful on ultrawide panels).
  gLvglPkgTokenSpaceGuid.PcdLvglCenteredFrameEnabled|FALSE|BOOLEAN|0x00000004

  ## Centered frame height as a percentage of the display height (1-100).
  gLvglPkgTokenSpaceGuid.PcdLvglCenteredFrameHeightPct|90|UINT8|0x00000005

  ## Centered frame width/height aspect ratio (width = height * Num / Den).
  gLvglPkgTokenSpaceGuid.PcdLvglCenteredFrameAspectNum|16|UINT8|0x00000006
  gLvglPkgTokenSpaceGuid.PcdLvglCenteredFrameAspectDen|9|UINT8|0x00000007

  ## When TRUE, promote the centered front-page banner (device model) into the
  ## Aptio subtitle bar and omit it from the scrollable content area. When FALSE,
  ## show the form title in the subtitle bar and render the centered banner in
  ## the content area (original behavior).
  gLvglPkgTokenSpaceGuid.PcdLvglAptioSubtitleShowsDeviceModel|FALSE|BOOLEAN|0x00000008

  ## File GUID of a FREEFORM file whose RAW section holds a TrueType font. When
  ## set, title/body/popup text is rendered with LVGL TinyTTF at the theme sizes,
  ## falling back to Montserrat for LV_SYMBOL_* glyphs. All-zero keeps the
  ## built-in Montserrat fonts.
  gLvglPkgTokenSpaceGuid.PcdLvglTtfFontFile|{ 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }|VOID*|0x00000009

  ## When TRUE, hide the UiApp front page and show its REF entries as a tab
  ## bar; LEFT/RIGHT switch tabs. FALSE keeps the front page (original behavior).
  gLvglPkgTokenSpaceGuid.PcdLvglFrontPageTabs|FALSE|BOOLEAN|0x0000000A

  ## Front-page QuestionId the engine selects to leave Setup (UiApp Continue).
  gLvglPkgTokenSpaceGuid.PcdLvglFrontPageContinueQuestionId|0x1000|UINT16|0x0000000B

  ## Front-page QuestionId the engine selects to reset (MdeModulePkg UiApp: 0x1001).
  gLvglPkgTokenSpaceGuid.PcdLvglFrontPageResetQuestionId|0x1001|UINT16|0x0000000C

  ## EFI scan code (SCAN_F1-SCAN_F12) that saves the screen as a BMP file on the
  ## first writable USB volume. 0 disables it.
  gLvglPkgTokenSpaceGuid.PcdLvglScreenshotScanCode|0x0000|UINT16|0x0000000D

  ## When TRUE, a mouse-focused String/Password/Numeric field pops up the
  ## on-screen keyboard. FALSE never creates it (physical keyboard only).
  gLvglPkgTokenSpaceGuid.PcdLvglOnScreenKeyboard|TRUE|BOOLEAN|0x0000000E

  ## When TRUE, PageUp/PageDown scroll the form by one page and focus the
  ## first/last fully visible row. FALSE keeps them as Shift+Tab/Tab.
  gLvglPkgTokenSpaceGuid.PcdLvglPageKeysScroll|FALSE|BOOLEAN|0x0000000F

  ## When TRUE, UP/DOWN scroll one page first (focus unchanged) when the next
  ## row is further than a page away or the move would wrap past hidden content.
  gLvglPkgTokenSpaceGuid.PcdLvglScrollBeforeFocus|FALSE|BOOLEAN|0x00000010

  ## When TRUE, a form entered for the first time (Setup entry, tab switch, REF)
  ## opens scrolled to the top with the focus on the browser's row; a rebuild of
  ## the same form keeps its scroll position; UP/DOWN toward an off-screen focus
  ## scroll toward it first. FALSE keeps the focus row scrolled into view.
  gLvglPkgTokenSpaceGuid.PcdLvglFormEntryTop|FALSE|BOOLEAN|0x00000011

  ## When TRUE, UP on the first row wraps to the last row. FALSE scrolls up to
  ## any hidden content first and then stays on the first row.
  gLvglPkgTokenSpaceGuid.PcdLvglNavUpWrap|TRUE|BOOLEAN|0x00000012

  ## When TRUE, the front page asks LvglEzChromeLib whether an EZ page exists.
  #  FALSE never calls LvglEzChromeLib.
  gLvglPkgTokenSpaceGuid.PcdLvglEzChromeEnable|FALSE|BOOLEAN|0x00000013

  ## EFI scan code that switches between the EZ page and the Advanced pages.
  #  0 = off.
  gLvglPkgTokenSpaceGuid.PcdLvglEzModeScanCode|0x0000|UINT16|0x00000014

  ## FV file GUID of this firmware's own Setup application. The EZ boot list
  #  skips a load option whose device path names this file. All zero = no
  #  GUID filtering (only LOAD_OPTION_HIDDEN entries are skipped).
  gLvglPkgTokenSpaceGuid.PcdLvglEzSetupAppFile|{ 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }|VOID*|0x00000015
