## @file
#  LVGL-based Display Engine DXE driver.
#
#  Hot-patches the EDKII_FORM_DISPLAY_ENGINE_PROTOCOL and EFI_HII_POPUP_PROTOCOL
#  instances installed by the text-mode DisplayEngineDxe, rendering through
#  LVGL when the console has a graphics output and falling back to text.
#
#  Copyright (c) 2024-2026, Hamit Karaca. All rights reserved.<BR>
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LvglDisplayEngine
  FILE_GUID                      = 2BBBB898-5D42-4273-8165-50D8542A5064
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = LvglDisplayEngineInit
  UNLOAD_IMAGE                   = LvglDisplayEngineUnload

[Sources]
  LvglDisplayEngineDxe.c
  LvglFormRenderer.c
  LvglFormRenderer.h
  LvglTextPopup.c
  LvglTextPopup.h
  LvglTextPopupScene.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  LvglPkg/LvglPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  DebugLib
  PrintLib
  BaseMemoryLib
  BaseLib
  MemoryAllocationLib
  HiiLib
  PcdLib
  LvglUiConfigLib
  LvglThemeLib
  LvglChromeLib
  LvglLib

[Guids]
  gEfiIfrTianoGuid                      ## CONSUMES ## GUID (Identify front-page banner opcodes)
  gLvglUiConfigFormSetGuid              ## CONSUMES
  gEfiEventExitBootServicesGuid         ## CONSUMES ## Event

[Protocols]
  gEdkiiFormDisplayEngineProtocolGuid   ## CONSUMES
  gEfiHiiPopupProtocolGuid              ## CONSUMES
  gEfiGraphicsOutputProtocolGuid        ## SOMETIMES_CONSUMES
  gEfiSimpleTextOutProtocolGuid         ## SOMETIMES_CONSUMES

[BuildOptions]
  # Same LVGL header warnings as LvglLib.inf.
  MSFT:*_*_*_CC_FLAGS = /wd4244 /wd4204 /wd4389 /wd4221 /wd4800 /wd4267 /wd4018 /wd4047 /wd4245 /wd4003 /wd4702 /wd4718 /wd4706 /wd4819 /wd4028 /wd5287

[Depex]
  gEdkiiFormDisplayEngineProtocolGuid AND gEfiHiiPopupProtocolGuid AND gEfiHiiDatabaseProtocolGuid AND gEfiHiiConfigRoutingProtocolGuid

