## @file
#  LVGL-based Display Engine DXE driver.
#
#  Produces EDKII_FORM_DISPLAY_ENGINE_PROTOCOL, replacing the text-mode
#  DisplayEngineDxe with an LVGL graphical renderer.
#
#  Copyright (c) 2024-2026, Hamit Karaca. All rights reserved.<BR>
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LvglDisplayEngine
  FILE_GUID                      = 2BBBB898-5D42-4273-8165-50D8542A5064
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = LvglDisplayEngineInit
  UNLOAD_IMAGE                   = LvglDisplayEngineUnload

[Sources]
  LvglDisplayEngineDxe.c
  LvglFormRenderer.c
  LvglFormRenderer.h
  LvglAptioChrome.c
  LvglAptioChrome.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  LvglPkg/LvglPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DebugLib
  PrintLib
  BaseMemoryLib
  BaseLib
  MemoryAllocationLib
  HiiLib
  PcdLib
  LvglUiConfigLib
  LvglThemeLib
  LvglLib

[Guids]
  gEfiIfrTianoGuid                      ## CONSUMES ## GUID (Identify front-page banner opcodes)
  gLvglUiConfigFormSetGuid              ## CONSUMES

[Protocols]
  gEdkiiFormDisplayEngineProtocolGuid   ## PRODUCES
  gEfiHiiPopupProtocolGuid              ## PRODUCES
  gEfiGraphicsOutputProtocolGuid        ## CONSUMES
  gEdkiiFormBrowserExProtocolGuid       ## CONSUMES

[BuildOptions]
  # Same LVGL header warnings as LvglLib.inf.
  MSFT:*_*_*_CC_FLAGS = /wd4244 /wd4204 /wd4389 /wd4221 /wd4800 /wd4267 /wd4018 /wd4047 /wd4245 /wd4003 /wd4702 /wd4718 /wd4706 /wd4819 /wd4028 /wd5287

[Depex]
  gEfiHiiDatabaseProtocolGuid AND gEfiHiiConfigRoutingProtocolGuid AND gEfiGraphicsOutputProtocolGuid

[Pcd]
  gLvglPkgTokenSpaceGuid.PcdLvglHelpPaneWidthPct
  gLvglPkgTokenSpaceGuid.PcdLvglAptioHeaderTitle
  gLvglPkgTokenSpaceGuid.PcdLvglAptioHeaderVendor
